<article class="article-reading-page">
  <header class="article-reading-header">
    <a href={~p"/"} class="apps-back">← All articles</a>
    <p class="apps-eyebrow">THE JOURNAL</p>
    <h1><%= @article.title %></h1>
    <div class="article-reading-meta">
      <span><%= @article.author %></span>
      <time datetime={Date.to_iso8601(@article.date)}><%= Calendar.strftime(@article.date, "%B %d, %Y") %></time>
      <span><%= @total_read_time %> min read</span>
    </div>
  </header>
  <div class="article-body trix-content prose prose-h1:mt-1 prose-h1:mb-1 prose-h2:mt-10 prose-h3:mt-8 prose-ul:mt-2 prose-li:mb-1 prose-li:mt-1 prose-p:mt-5 prose-p:mb-2">
    <%= raw @article.html_body %>
  </div>
  <footer class="article-reading-footer"><a href={~p"/"} class="apps-secondary-button">← All articles</a><a href={~p"/apps"} class="apps-text-link">Explore the apps <span aria-hidden="true">→</span></a></footer>
</article>
