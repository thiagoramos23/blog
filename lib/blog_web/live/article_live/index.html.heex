<div class="articles-page">
  <header class="articles-intro">
    <p class="apps-eyebrow">ARTICLES</p>
    <h1>Writing on software, programming languages and weird thoughts about life.</h1>
    <p class="apps-lead">All of my not so long-form thoughts on programming, career, product design, and some life philosophy, all in chronological order.</p>
    <div class="apps-actions"><a href="#articles" class="apps-button">Read the latest <span aria-hidden="true">↓</span></a><a href="/feed" class="apps-secondary-button">RSS feed <span aria-hidden="true">↗</span></a></div>
  </header>
  <section id="articles" class="apps-feature-band articles-list" aria-labelledby="articles-heading">
    <div class="articles-list-inner">
      <p class="apps-eyebrow">THE JOURNAL</p>
      <h2 id="articles-heading">Latest articles.</h2>
      <p :if={@articles == []} class="articles-empty">No articles yet. Check back soon.</p>
      <BlogWeb.Components.Article.article :for={article <- @articles}
        title={article.title} summary={article.summary} date={article.date}
        route={Routes.article_show_path(@socket, :show, article.slug)} />
    </div>
  </section>
</div>
